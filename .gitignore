# ==========================================
# ResumeAI - Git Ignore Configuration
# Protects secrets, private data & dependencies
# ==========================================

# 1. Environment Variables & Secret Credentials (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert

# 2. Candidate Resume Uploads (Confidential User Data)
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/sample_alex_morgan_resume.pdf

# 3. Local Databases & Runtime Storage (User records, hashes)
backend/data/*.json
!backend/data/.gitkeep
*.sqlite
*.sqlite3
*.db
*.rdb

# 4. Node.js Dependencies & Logs
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Frontend Production Builds & Caches
frontend/dist/
frontend/build/
.vite/
frontend/.vite/
dist/
build/
.cache/

# 6. Python Virtual Environments & Bytecode
.venv/
venv/
ENV/
env/
ai_service/.venv/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.egg
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 7. Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 8. Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 9. General Log Files
*.log
logs/
